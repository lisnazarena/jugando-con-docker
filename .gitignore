# Dependencias de Node.js
node_modules/

# Lockfile vacío que crea npm si se corre en la raíz, donde no hay package.json.
# Los de frontend/ y backend/ sí se versionan.
/package-lock.json

# Secretos. .env.example sí se versiona.
.env
.env.*
!.env.example

# Compilación de React y del backend
frontend/dist/
frontend/build/
backend/dist/
*.tsbuildinfo

# Logs y archivos temporales
logs/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.swp
*~

# Datos locales de PostgreSQL, volúmenes y copias de seguridad
postgres-data/
db/data/
**/pgdata/
backups/
*.sql.gz
*.dump
volumes/

# Configuración local de Compose que puede tener claves
docker-compose.override.yml

# Cobertura de pruebas
coverage/
.nyc_output/

# Ajustes personales del editor
.idea/
.vscode/
