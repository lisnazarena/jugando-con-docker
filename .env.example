# Copiá este archivo a .env y reemplazá los valores.
# El archivo .env no se sube al repositorio.

POSTGRES_USER=lluvia
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=lluvia

# Hoy la API corre en Ubuntu y PostgreSQL en un contenedor publicado en esta máquina.
DATABASE_URL=postgresql://lluvia:cambiar-esta-clave@127.0.0.1:5435/lluvia

# El jueves, con Compose, la API estará en la red de Docker y usará el nombre del servicio:
# DATABASE_URL=postgresql://lluvia:cambiar-esta-clave@db:5432/lluvia

# Puertos en Ubuntu. 8088 y 5435 evitan chocar con otros proyectos.
WEB_PORT=8088
API_PORT=4000
POSTGRES_PORT=5435
